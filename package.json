{
  "name": "multiprise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "generate:icons": "electron scripts/generate-icons.cjs",
    "dev:api": "tsx backend/src/dev.ts",
    "dev:web": "npm run dev:renderer",
    "dev:renderer": "vite --config renderer/vite.config.js",
    "dev:electron": "electron .",
    "build:api": "npm run build:backend",
    "build:web": "npm run build:renderer",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "build:backend": "node scripts/clean-backend.mjs && tsc -p backend/tsconfig.json",
    "start": "electron .",
    "package:mac": "npm run generate:icons && npm run build:api && npm run build:web && electron-builder --mac",
    "test:backend": "npm run build:api && node --test backend/test/*.test.cjs",
    "test": "npm run test:backend && npm run build:web"
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.40"
  },
  "description": "A local desktop control center for launching projects, assigning ports, viewing logs, and browsing running services.",
  "author": "Djbrl",
  "license": "MIT",
  "build": {
    "appId": "com.djbrl.multiprise",
    "productName": "Multiprise",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "shell-path.cjs",
      "package.json",
      "port-ranges.json",
      "build/icon.png",
      "renderer/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Multiprise ${version}"
    },
    "artifactName": "Multiprise-${version}-${arch}.${ext}"
  }
}
